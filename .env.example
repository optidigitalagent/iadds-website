# Optional, server-only canonical origin. Production defaults to the existing Site.
# Local dev/test wrappers supply their own loopback origin. No .env file is needed.
SITE_URL=https://iadds-by-antonov-digital.funckj.chatgpt.site
# Required only to accept real production consultations; absent => honest HTTP 503.
# Server-only public HTTPS receiver. Never put credentials in its URL.
CONSULTATION_WEBHOOK_URL=
# Required server-only HMAC secret (at least 32 random bytes); configure in hosting secrets.
CONSULTATION_WEBHOOK_SECRET=
CONSULTATION_WEBHOOK_SOURCE=iadds
# Gateway-only variables are documented in docs/lead-gateway.md. No Telegram token belongs on this site.
# Optional server-only. Enable only if the proxy overwrites X-Forwarded-For.
TRUST_PROXY=false
# Optional server-only relative subdirectory of .data. Development/test storage only.
CONSULTATION_LOCAL_DIR=consultations
# Internal build flags are set by npm scripts; do not enable local review on hosting.
# IADDS_MEDIA_MODE=production
# IADDS_REVIEW_BUILD=false
# No live analytics provider is configured; ANALYTICS_ID is not consumed by the app.
